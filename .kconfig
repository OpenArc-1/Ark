SD_ENABLE=1
FAT32_ENABLE=1
RAMFS_ENABLE=1
AFS_ENABLE=1
AFS_GPT=1
AFS_MBR=1
VFS_ENABLE=1
ZIP_ENABLE=1

NET_ENABLE=1
E1000_ENABLE=1
E100_ENABLE=1
IP_ENABLE=1
UDP_ENABLE=1
TCP_ENABLE=1

AUDIO_ENABLE=1
AC97_ENABLE=1
HDA_ENABLE=1

KBD_ENABLE=1
MOUSE_ENABLE=1
